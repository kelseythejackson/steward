{
  "name": "steward-monorepo",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b packages/cli",
    "typecheck": "tsc -b packages/cli eval",
    "test": "vitest run",
    "steward": "tsx --conditions=source packages/cli/src/bin.ts",
    "eval:score": "tsx --conditions=source eval/src/main.ts score",
    "eval:summary": "tsx --conditions=source eval/src/main.ts summary"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
